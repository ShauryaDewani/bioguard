# Firebase web app (Firebase console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin service account, as one line of JSON
FIREBASE_SERVICE_ACCOUNT_KEY=

# Gemini, for document analysis and the chat assistant
GEMINI_API_KEY=

# Optional: live health news (falls back to sample articles without it)
NEWS_API_KEY=

# Optional: Google Maps for the nearby doctors map
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: account exempt from the daily analysis limit
ADMIN_EMAIL=
